{
  "name": "meteo-data-collector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Config-driven meteorological data collector for Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:dashboard && wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply meteo-data --local",
    "migrate:remote": "wrangler d1 migrations apply meteo-data --remote",
    "build:dashboard": "npm --prefix dashboard run build",
    "dev:dashboard": "npm --prefix dashboard run dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}